[Unit]
Description=Sync Gmail (mbsync + notmuch)

[Service]
Type=oneshot
# Background sync reads only the session's local Secret Service cache. Skip
# quietly until `mail-credential refresh` has populated it from Bitwarden.
ExecCondition=/bin/sh -c '/home/quangdn/.local/bin/mail-credential status >/dev/null 2>&1'
ExecStart=/home/quangdn/.config/aerc/mail-sync
