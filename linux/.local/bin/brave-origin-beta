#!/usr/bin/env bash
XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"

args=()
flags_file="$XDG_CONFIG_HOME/brave-origin-beta-flags.conf"
if [[ -r $flags_file ]]; then
    while IFS= read -r line || [[ -n $line ]]; do
        line="${line%%#*}"
        [[ -z "$line" ]] && continue
        args+=("$line")
    done < "$flags_file"
fi

exec /opt/brave.com/brave-origin-beta/brave-origin "${args[@]}" "$@"
