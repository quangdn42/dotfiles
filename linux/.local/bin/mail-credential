#!/bin/sh
set -eu

# Local cache for the single Gmail app password used by aerc, mbsync, msmtp,
# and vdirsyncer. Normal reads only touch Secret Service; Bitwarden is accessed
# exclusively by an explicit `mail-credential refresh`.

service="dotfiles-mail"
account="ammon134@gmail.com"
label="Gmail app password for local mail clients"
bitwarden_item="Main Gmail"
bitwarden_field="AppPassword_aerc"
relock_rbw=0
credential=""

usage() {
    cat >&2 <<'EOF'
Usage: mail-credential [get|status|refresh]

  get      Print the cached credential (default; intended for mail clients)
  status   Report whether the local cache is populated
  refresh  Sync Bitwarden and replace the local cached credential
EOF
}

require() {
    if ! command -v "$1" >/dev/null 2>&1; then
        echo "mail-credential: required command not found: $1" >&2
        exit 127
    fi
}

lookup() {
    require secret-tool

    if ! credential=$(secret-tool lookup service "$service" account "$account" 2>/dev/null) \
        || [ -z "$credential" ]; then
        echo "mail-credential: no cached credential; run 'mail-credential refresh'" >&2
        return 1
    fi

    printf '%s\n' "$credential"
    credential=""
}

cleanup() {
    credential=""
    if [ "$relock_rbw" -eq 1 ]; then
        rbw lock >/dev/null 2>&1 || true
    fi
}

refresh() {
    require rbw
    require secret-tool

    # Preserve the caller's rbw state: a vault unlocked just for this refresh
    # is locked again on success, failure, or interruption.
    if ! rbw unlocked >/dev/null 2>&1; then
        relock_rbw=1
        echo "Unlocking Bitwarden for this refresh..." >&2
        rbw unlock
    fi

    echo "Syncing Bitwarden..." >&2
    rbw sync
    credential=$(rbw get "$bitwarden_item" --field="$bitwarden_field")
    if [ -z "$credential" ]; then
        echo "mail-credential: Bitwarden returned an empty credential" >&2
        return 1
    fi

    printf '%s\n' "$credential" \
        | secret-tool store --label="$label" service "$service" account "$account" >/dev/null
    credential=""

    echo "Updated the local mail credential cache for $account." >&2
}

trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

case "${1:-get}" in
    get)
        [ "$#" -le 1 ] || { usage; exit 2; }
        lookup
        ;;
    status)
        [ "$#" -le 1 ] || { usage; exit 2; }
        if lookup >/dev/null 2>&1; then
            echo "Local mail credential cache is populated."
        else
            echo "Local mail credential cache is empty."
            exit 1
        fi
        ;;
    refresh)
        [ "$#" -le 1 ] || { usage; exit 2; }
        refresh
        ;;
    -h | --help | help)
        usage
        ;;
    *)
        usage
        exit 2
        ;;
esac
