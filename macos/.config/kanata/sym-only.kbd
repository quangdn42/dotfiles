;; Kanata MacBook Configuration

(defcfg
  process-unmapped-keys no
  concurrent-tap-hold   yes
  macos-dev-names-include (
    "Apple Internal Keyboard / Trackpad"
  )
  tap-hold-require-prior-idle 100
)

(defhands
  (left  q w e r t a s d f g z x c v b)
  (right y u i o p h j k l ; ' n m , . /)
)

(defsrc
  esc   f1    f2    f3    f4    f5    f6    f7    f8    f9    f10   f11   f12
  grv   1     2     3     4     5     6     7     8     9     0     -     =     bspc
  tab   q     w     e     r     t     y     u     i     o     p     [     ]     \
  caps  a     s     d     f     g     h     j     k     l     ;     '     ret
  lsft  z     x     c     v     b     n     m     ,     .     /     rsft
  fn    lctl  lalt  lmet                    spc                       rmet  ralt
)

(defvar
  tap-time 200
  hold-time 150
  pinky-hold-time 150
)

(defalias
  ;; Ctrl Esc
  esc (tap-hold $tap-time $hold-time esc lctl)

  ;; Fn layer
  fn-hold (multi fn (layer-while-held fn))
  fn-on (tap-hold 200 200 (multi (macro A-spc) (layer-switch nomods)) @fn-hold)
  fn-off (tap-hold 200 200 (multi (macro A-spc) (layer-switch base)) @fn-hold)

  ;; Home row mods
  z (tap-hold-opposite-hand $hold-time z lalt (timeout hold))
  x (tap-hold-opposite-hand $hold-time x lmet (timeout hold))
  c (tap-hold-opposite-hand $hold-time c lctl (timeout hold))

  m (tap-hold-opposite-hand $hold-time m rctl (timeout hold))
  comm (tap-hold-opposite-hand $hold-time , rmet (timeout hold))
  dot (tap-hold-opposite-hand $hold-time . ralt (timeout hold))
  slsh (tap-hold-opposite-hand $hold-time / rsft (timeout hold))

  ;; Apostrophe as left-Alt mod-tap (home row mod)
  apos (tap-hold-opposite-hand $pinky-hold-time ' lalt (timeout hold))

  ;; Symbol Layer (hold Space)
  spc (tap-hold-release 175 175 spc (layer-while-held symbols) (require-prior-idle 0))
  ;; Numbers Layer (hold A)
  a (tap-hold-release 175 175 a (layer-while-held numbers) (require-prior-idle 0))

  ;; Symbol layer bottom row mods
  symz (tap-hold-opposite-hand $hold-time S-= lalt (timeout hold))
  symx (tap-hold-opposite-hand $hold-time S-8 lmet (timeout hold))
  symc (tap-hold-opposite-hand $hold-time S-9 lctl (timeout hold))
)

(deflayer base
  esc     brdn  brup  mctl  sls   dtn   dnd   prev  pp    next  mute  vold  volu
  grv     1     2     3     4     5     6     7     8     9     0     -     =     bspc
  tab     q     w     e     r     t     y     u     i     o     p     [     ]     S-min
  @esc    @a    s     d     f     g     h     j     k     l     ;     @apos ret
  lsft    @z    @x    @c    v     b     n     @m    @comm @dot  @slsh rsft
  @fn-on  lctl  lalt  lmet        @spc                      lctl  ralt
)

(deflayer nomods
  esc     brdn  brup  mctl  sls   dtn   dnd   prev  pp    next  mute  vold  volu
  grv     1     2     3     4     5     6     7     8     9     0     -     =     bspc
  tab     q     w     e     r     t     y     u     i     o     p     [     ]     \
  caps    a     s     d     f     g     h     j     k     l     ;     @apos ret
  lsft    z     x     c     v     b     n     m     ,     .     /     rsft
  @fn-off lctl  lalt  lmet        spc                       lctl  ralt
)

(deflayer numbers
  _     _     _     _     _     _     _     _     _     _     _     _     _
  _     _     _     _     _     _     _     7     8     9     _     _     _     _
  _     _     _     _     _     _     _     4     5     6     min   _     _     _
  _     _     _     _     _     _     _     1     2     3     +     _     _
  _     _     _     _     _     _     S-8   0     0     .     /     _
  _     _     _     _                       _                         _     _   
)

(deflayermap (nav)
  h  left
  j  down
  k  up
  l  right

  a  lctl
  s  lalt
  d  lsft
  f  lmet
)

(deflayer fn
  esc   f1    f2    f3    f4    f5    f6    f7    f8    f9    f10   f11   f12
  _     _     _     _     _     _     _     _     _     _     _     _     _     del
  _     _     _     _     _     _     _     _     _     _     _     _     _     _
  _     _     _     _     _     _     _     _     _     _     _     _     _
  _     _     _     _     _     _     _     _     _     _     _     _
  _     _     _     _                       _                         _     _
)

(deflayer symbols
;;        <     >     :     -     |     \     ^     $     %     p     [     ]     \
;;        !     {     }     =     &     left  down  up    right $     '
;;        +     *     (     )     ~     #     @     .     ;     ,
;;   Holds: z=lalt x=lmet c=lctl
  esc   brdn  brup  mctl  sls   dtn   dnd   prev  pp    next  mute  vold  volu
  grv   1     2     3     4     5     6     7     8     9     0     -     =     bspc
  tab   S-,   S-.   S-;   -     S-\   \     S-6   S-4   S-5   \     bspc  del   \
  caps  S-1   S-[   S-]   =     S-7   left  down  up    right S-4   @apos ret
  lsft  @symz @symx @symc S-0   S-`   S-3   S-2   .     ;     ,     rsft
  _     lctl  lalt  lmet                    spc                       lctl  ralt
)
