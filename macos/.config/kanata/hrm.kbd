;; Kanata MacBook Configuration

(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold   yes
  tap-hold-require-prior-idle 100
)

(defhands
  (left  q w e r t a s d f g z x c v b)
  (right y u i o p h j k l ; ' n m , . /)
)

(defsrc
  esc  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lalt lmet           spc                 rmet ralt
)

(defvar
  tap-time 200
  hold-time 150
  pinky-hold-time 150
)

(defalias
;; Home row mods
  a (tap-hold-opposite-hand $hold-time a lmet (timeout hold))
  s (tap-hold-opposite-hand $hold-time s lalt (timeout hold))
  d (tap-hold-opposite-hand $hold-time d lctl (timeout hold))
  f (tap-hold-opposite-hand $hold-time f lsft (timeout hold))

  j (tap-hold-opposite-hand $hold-time j rsft (timeout hold))
  k (tap-hold-opposite-hand $hold-time k rctl (timeout hold))
  l (tap-hold-opposite-hand $hold-time l ralt (timeout hold))
  ; (tap-hold-opposite-hand $pinky-hold-time ; rmet (timeout hold))

  ;; Apostrophe as left-Alt mod-tap (home row mod)
  apos (tap-hold-opposite-hand $pinky-hold-time ' lalt (timeout hold))

  ;; W and O hold to reach the symbol layer
  w (tap-hold-opposite-hand $hold-time w (layer-while-held symbols) (timeout hold))
  o (tap-hold-opposite-hand $hold-time o (layer-while-held symbols) (timeout hold))

  ;; Navigation Layer (hold Space)
  spc (tap-hold 200 200 spc (layer-while-held nav) (require-prior-idle 0))
)

(deflayer base
  grv 1 2 3 4 5 6 7 8 9 0 - = bspc
  tab q  @w e  r t y u i @o p [ ] \
  esc @a @s @d @f g h @j @k @l @; @apos ret
  lsft z x c v b n m , . / rsft
  lctl lalt lmet    @spc       lctl ralt
)

(deflayermap (nav)
  h left
  j down
  k up
  l right

  a lctl
  s lalt
  d lsft
  f lmet
)

;; Symbol Layer (hold W or O)
(deflayer symbols
;;   ` < > / . | ~ [ ] @
;;   ! " + = - & : ( ) %
;;   . \\ _ # * ^ $ { } ?
  esc  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  `    S-,  S-.  /    .    S-\  S-`  [    ]    S-2  [    ]    \
  caps S-1  S-'  S-=  =    -    S-7  S-;  S-9  S-0  S-5  @apos ret
  lsft \    \    S--  S-3  S-8  S-6  S-4  S-[  S-]  S-/    rsft
  lctl lalt lmet           spc                 lctl ralt
)
