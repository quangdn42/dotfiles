{
  "schema_version": 1,
  "naming": "stable filenames inside a timestamped run directory",
  "archives": [
    {
      "id": "credentials",
      "filename": "credentials.tar.zst.age",
      "disposition": "encrypted_archive",
      "capture_adapter": "filesystem",
      "sources": [".ssh", ".gnupg"],
      "excludes": [],
      "required": false,
      "restore_policy": "stage_only",
      "sensitivity": "secret"
    },
    {
      "id": "developer-history",
      "filename": "developer-history.tar.zst.age",
      "disposition": "encrypted_archive",
      "capture_adapter": "filesystem",
      "sources": [
        ".local/share/fish/fish_history",
        ".sqlite_history",
        ".psql_history",
        ".mysql_history",
        "Library/Application Support/zoxide/db.zo",
        "Library/Application Support/lazygit/state.yml"
      ],
      "excludes": [],
      "required": false,
      "requires_stopped": ["obs", "gimp", "gimp-3.0", "steam_osx"],
      "restore_policy": "stage_only",
      "sensitivity": "sensitive"
    },
    {
      "id": "personal",
      "filename": "personal.tar.zst.age",
      "disposition": "encrypted_archive",
      "capture_adapter": "filesystem",
      "sources": ["Documents", "Desktop", "Pictures", "Movies", "Music"],
      "excludes": [],
      "required": false,
      "restore_policy": "merge_no_overwrite",
      "sensitivity": "sensitive"
    },
    {
